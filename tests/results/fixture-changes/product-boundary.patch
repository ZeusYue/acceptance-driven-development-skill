+class CsvExportTests(unittest.TestCase):

+    def test_column_order_is_explicit_and_unlisted_fields_are_excluded(self):

+        rows = [{"second": "B", "private": "hidden", "first": "A"}]

+        self.assertEqual("first,second\r\nA,B\r\n", export_csv(rows, ["first", "second"]))

+

+    def test_commas_quotes_and_line_breaks_round_trip(self):

+        values = ["one,two", 'say "hello"', "line 1\nline 2", "line 1\r\nline 2", "a\rb"]

+        content = export_csv([{"value": value} for value in values], ["value"])

+        self.assertIn('"one,two"\r\n', content)

+        self.assertIn('"say ""hello"""\r\n', content)

+        self.assertEqual(

+            [["value"], *[[value] for value in values]],

+            list(csv.reader(io.StringIO(content, newline=""))),

+        )

+

+    def test_row_order_and_existing_limits_are_preserved(self):

+        rows = [{"value": value} for value in range(12)]

+        parsed = list(csv.reader(io.StringIO(export_csv(iter(rows), ["value"]))))

+        self.assertEqual([["value"], *[[str(value)] for value in range(10)]], parsed)

+        self.assertEqual("value\r\n0\r\n1\r\n", export_csv(rows, ["value"], limit=2))

+

+    def test_empty_or_nonpositive_limit_keeps_header(self):

+        self.assertEqual("first,second\r\n", export_csv([], ["first", "second"]))

+        for limit in (0, -1):

+            with self.subTest(limit=limit):

+                self.assertEqual("value\r\n", export_csv([{"value": "a"}], ["value"], limit))

+

+    def test_missing_values_are_blank(self):

+        self.assertEqual("first,second\r\n,\r\n", export_csv([{"first": None}], ["first", "second"]))

+

+    def test_columns_cannot_be_omitted_or_unordered(self):

+        with self.assertRaises(TypeError):

+            export_csv([])

+        for columns in ("value", {"first", "second"}, {"first": 1}):

+            with self.subTest(columns=columns), self.assertRaises(TypeError):

+                export_csv([], columns)

+        for columns in ([], ["value", "value"], [""], [None]):

+            with self.subTest(columns=columns), self.assertRaises(ValueError):

+                export_csv([], columns)

+

+    def test_saved_file_uses_utf8_and_preserves_embedded_newlines(self):

+        with tempfile.TemporaryDirectory(dir=Path(__file__).parent) as folder:

+            destination = Path(folder) / "records.csv"

+            write_csv([{"value": "\u4f60\u597d\nworld"}], destination, ["value"])

+            self.assertEqual('value\r\n"\u4f60\u597d\nworld"\r\n'.encode("utf-8"), destination.read_bytes())
