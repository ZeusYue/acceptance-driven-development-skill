+def export_rows(rows, limit=DEFAULT_LIMIT):

+    return list(rows)[:max(0, limit)]

+

+

+def export_csv(rows, columns, limit=DEFAULT_LIMIT):

+    """Render records using an explicit, ordered list of approved columns.

+

+    This helper does not choose which fields may be shared publicly. Columns

+    must be supplied by the caller; unlisted fields are never included.

+    """

+    if isinstance(columns, (str, bytes)) or not isinstance(columns, Sequence):

+        raise TypeError("columns must be an ordered sequence of field names")

+    columns = tuple(columns)

+    if not columns or any(not isinstance(column, str) or not column for column in columns):

+        raise ValueError("columns must contain nonempty field names")

+    if len(set(columns)) != len(columns):

+        raise ValueError("columns must not contain duplicates")

+

+    output = io.StringIO(newline="")

+    writer = csv.DictWriter(output, fieldnames=columns, extrasaction="ignore")

+    writer.writeheader()

+    writer.writerows(export_rows(rows, limit))

+    return output.getvalue()

+

+

+def write_csv(rows, destination, columns, limit=DEFAULT_LIMIT):

+    """Save a UTF-8 CSV file, suitable for serving as a download attachment."""

+    content = export_csv(rows, columns, limit)

+    with open(destination, "w", encoding="utf-8", newline="") as output:

+        output.write(content)

